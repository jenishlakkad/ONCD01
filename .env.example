# Copy this file to .env and fill in real values. .env is never committed.

# Server
PORT=8843
SESSION_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# Mailer (SMTP). Works with a raw SMTP account, or any provider that exposes
# an SMTP endpoint (Resend: smtp.resend.com, SendGrid: smtp.sendgrid.net, etc).
# If left blank, OTP codes are printed to the server console instead of emailed,
# so registration/reset flows remain fully testable without real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER= naturaldiamond80@gmail.com
SMTP_PASS= sndj kiej aluy nngr
SMTP_FROM="ONCD <no-reply@oncd.com>"
