# Copy this file to .env and fill in real values. .env is never committed.

# Server
PORT=8843
SESSION_SECRET=replace-with-a-long-random-string
NODE_ENV=development

# Mailer. On Render's free plan SMTP ports are blocked, so set BREVO_API_KEY
# there (brevo.com > SMTP & API > API keys; free 300 emails/day). MAIL_FROM
# must be a sender verified in Brevo (Senders, domains & dedicated IPs).
# Locally, Gmail SMTP below is enough. With neither, OTP codes are printed
# to the server console instead of emailed.
BREVO_API_KEY=
MAIL_FROM="ONCD <you@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ONCD <you@example.com>"

# Database (Supabase Postgres connection string)
DATABASE_URL=

# Cloudflare R2 media storage
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_MEDIA_READS_ENABLED=true
